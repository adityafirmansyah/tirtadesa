# App Environment
ENVIRONMENT=development
PROJECT_NAME="TirtaDesa"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: SQLite (zero-config, lightweight for single village deployment)
DATABASE_URL=sqlite:///./tirtadesa.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://tirtadesa:tirtadesa123@localhost:5432/tirtadesa

# Auto Seed default demo data on fresh empty database
AUTO_SEED=true

# Storage
UPLOAD_DIR=./uploads

# WhatsApp Gateway (Optional, 1-way notifications)
WHATSAPP_ENABLED=false
WHATSAPP_GATEWAY_URL=https://gateway.example.com/send
WHATSAPP_API_KEY=
